// Copy this file to Local.xcconfig and fill in your own values.
//   cp Config/Local.xcconfig.example Config/Local.xcconfig
// Local.xcconfig is gitignored so real values never get committed.
//
// You need your own Apple Developer team, a Firebase project
// (GoogleService-Info.plist), an AWS account with an SNS platform
// application + a Cognito identity pool, and a RevenueCat project.
// See README for setup.

DEVELOPMENT_TEAM = 1234567890
RC_API_KEY = appl_dummy_revenuecat_key_for_local_testing
COGNITO_POOL_ID = us-east-1:00000000-0000-0000-0000-000000000000
AWS_REGION = us-east-1
AWS_ACCOUNT_ID = 123456789012
SNS_APP_NAME = LocalTestingApp

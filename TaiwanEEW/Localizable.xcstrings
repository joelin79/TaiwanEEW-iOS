    "auto-cant-manual-footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are automatically locating you, so you can’t manually pick a location."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動位置特定が実行中のため、手動で地域を選択することはできません"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動定位運作中，無法手動選擇地區"
          }
        }
      }
    },
    "autoloc-denied-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is denied, we cannot determine your location."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報の権限が無効になっているため、お客様の位置情報を取得できません"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置權限已關閉，無法取得您的位置"
          }
        }
      }
    },
    "autoloc-footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, your alert district is chosen automatically from your location. The nearest intensity reference point is not necessarily inside the district you are in. Background updates require the “Always” location permission."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、現在地から最も近い地震通知地域が自動的に選択されます。最も近い震度参照点が、必ずしも現在いる地域内にあるとは限りません。バックグラウンド更新には「常に許可」の位置情報権限が必要です。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後將自動根據您的位置選擇最近的地震通知區域（距離最近的震度參考點未必在您所在的區域界內）。需要「永遠」位置權限以啟用背景更新。"
          }
        }
      }
    },

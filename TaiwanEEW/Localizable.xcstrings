        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの起動時のみ更新されます。「常に許可」に設定しないと、バックグラウンドでエリアが自動的に切り替わりません。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在開啟App時更新，需要「一律允許」才能在背景自動切換區域"
          }
        }
      }
    },

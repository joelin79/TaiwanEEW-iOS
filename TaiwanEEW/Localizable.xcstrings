    "auto-location-desc-string" : {
      "extractionState" : "migrated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically picks the nearest alert region from your location and keeps it updated as you move. You can change this later in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地から最寄りの通知地域を自動で選び、移動しても自動的に更新します。あとから「設定」で変更できます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動依您的位置選擇最近的通知區域，移動時也會自動更新。之後可在「設定」中更改。"
          }
        }
      }
    },

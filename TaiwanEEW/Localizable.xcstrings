    "autoloc-foreground-only-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is limited to foreground only, we need Always Allow to switch alert regions in the background."

    "donate-1-string" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In order to make instant earthquake alerts available to everyone, our application if free for anyone to download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰もがリアルタイムの地震早期警報を受け取れるようにするため、このアプリのダウンロードは無料です。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了讓人人都可以取得即時地震預警，此應用程式下載不需付費。"
          }
        }
      }
    },
    "donate-2-string" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For the sake of this app, the developer had bought servers and facilities for over a hundred thousand worth in NTD, pays for cloud rent costs monthly, and can only maintain the app during the developer’s free time when he’s away from school."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発者はこのアプリのために、10万元を超えるサーバーなどの機器を購入し、毎月クラウドサービスの利用料を支払いつつ、限られた放課後の時間を割いて開発とメンテナンスを行っている。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開發者為了此應用程式，購置逾十萬元伺服器等設備，並每月支出雲端服務租賃費用，在有限的課餘時間開發與維護。"
          }
        }
      }
    },
    "donate-3-string" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you like this app, please consider supporting the developer. Not only can it reduce the development costs every month, your generous donations can also upgrade the equipments, helping the app provide even better quality, sustaining our service to you."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリを気に入っていただけましたら、開発者へのご支援をご検討いただければ幸いです。ご支援は開発者の毎月の経費負担を軽減するだけでなく、機器のアップグレードにも充てられ、アプリの品質向上につながり、今後も皆様にサービスを提供し続けるための助けとなります。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您喜歡此應用程式，希望您考慮給予開發者一些贊助，不僅能減輕開發者每月的開銷，您的慷慨解囊將用於設備升級，有助於提高應用程式的品質，永續為您服務。"
          }
        }
      }
    },
    "donate-eew-detail-string" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can support the developer and sustain the app through small donations!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少額の寄付を通じて、開発者の負担を軽減し、\nアプリの持続的な運営を支えることができます"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

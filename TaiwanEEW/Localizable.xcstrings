    "term-title-string" : {
      "comment" : "Terms of Use",
      "extractionState" : "migrated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disclaimer"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免責聲明"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免責聲明"
          }
        }
      }
    },
    "term1-string" : {
      "extractionState" : "migrated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earthquakes are unpredictable! Any information should be based on the official announcements from the Central Weather Association (CWA)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "【地震は予測不可能です】すべての情報は中央気象庁（CWA）の公表に基づいてください。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "【地震無法預測】，任何資訊均以中央氣象署(CWA)發布之內容為準。"
          }
        }
      }
    },
    "term2-string" : {
      "extractionState" : "migrated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The earthquake early warning system, based on rapid calculations from a few seismic stations, may differ from the final earthquake report. Please exercise caution when using it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強震即時警報は、わずかな地震測定所の迅速な演算結果に基づいています。最終的な地震報告とは若干の差異がある場合がありますので、ご理解の上、慎重にご利用ください。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強震即時警報是利用少數幾個地震測站快速演算之結果，與最終地震報告可能存有若干差異，請理解並謹慎使用。"
          }
        }
      }
    },
    "term3-string" : {
      "extractionState" : "migrated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "False alarms are possible. Please refrain from disseminating information, maintain public order, and ensure compliance with the law."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測報は誤報の可能性がありますので、情報の拡散は避け、公共の秩序を維持し、法に触れないようにしてください。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測報可能誤報，請勿散播資訊，保持公共秩序，避免觸法。"
          }
        }
      }
    },
    "term4-string" : {
      "extractionState" : "migrated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you start using this software, it automatically implies your agreement to the Terms of Service."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本ソフトウェアの使用を開始した場合、それは利用規約に同意したことを意味します。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若您開始使用本軟體，表示您已同意所有服務條款。"
          }
        }
      }
    },

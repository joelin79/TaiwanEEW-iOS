        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報の許可が得られないため、お住まいの地域を手動で選択してください。あとから「設定」で位置情報を許可すると、自動位置情報に切り替えられます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
